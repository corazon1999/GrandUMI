{
  "name": "opcgpro-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/build-card-bundle.mjs",
    "dev": "next dev -H 0.0.0.0",
    "prebuild": "node scripts/build-card-bundle.mjs",
    "build": "next build",
    "build:cards": "node scripts/build-card-bundle.mjs",
    "check:audio": "node scripts/check-audio-assets.mjs",
    "test:zone-transitions": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/card-zone-transitions.test.mjs",
    "test:replay-hands": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/replay-hands.test.mjs",
    "test:game-layout": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/game-layout.test.mjs",
    "test:card-hover": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/card-hover-placement.test.mjs",
    "test:game-overlays": "node --test tests/game-overlay-portals.test.mjs",
    "test:effect-confirm": "node --test tests/effect-confirm-prompt-layout.test.mjs",
    "test:deck-plaza": "node --test tests/deck-plaza.test.mjs",
    "test:deck-image-export": "node --test tests/deck-image-export.test.mjs",
    "gen:card-thumbs": "node scripts/gen-card-thumbs.mjs",
    "start": "next start"

{
  "OP13-014": {
    "_name": "波特夹斯·D·露秀",
    "_matcher": "生命【触发】：选我方领航或角色区最多1张名为艾斯的卡本回合力量+3000",
    "_src": "wf-dsl",
    "trigger": [
      {
        "op": "Choose",
        "prompt": "OwnLeaderOrCharacter",
        "max": 1,
        "min": 0,
        "as": "$tgt",
        "filter": {
          "nameEquals": "波特夹斯·D·艾斯"
        }
      },
      {
        "op": "AddPowerThisTurn",
        "target": "$tgt",
        "delta": 3000
      }
    ]
  },
  "OP13-080": {
    "_name": "伊赞巴隆·V·纳斯寿郎圣",
    "_matcher": "已按官方文本逐项精确补齐；组合式实现保留原 DSL 主体并覆盖完整成本、条件与后续结算。",
    "_src": "wf-dsl",
    "triggers": [
      {
        "on": "OnAttackDeclare",
        "if": {
          "ownTrashCountGte": 10
        },
        "then": [
          {
            "op": "Choose",
            "prompt": "OpponentCharacter",
            "max": 1,
            "min": 0,
            "as": "$tgt"
          },
          {
            "op": "AddPowerThisTurn",
            "target": "$tgt",
            "delta": -2000
          }
        ]
      }
    ]
  },
  "OP13-109": {
    "_name": "杰丽·邦妮",
    "_matcher": "已按官方文本逐项精确补齐；组合式实现保留原 DSL 主体并覆盖完整成本、条件与后续结算。",
    "_src": "wf-dsl",
    "trigger": [
      {
        "op": "Draw",
        "n": 2
      },
      {
        "op": "DiscardOwnChosen",
        "n": 1
      }
    ]
  }
}

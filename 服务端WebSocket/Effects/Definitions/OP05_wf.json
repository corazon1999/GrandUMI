{
  "OP05-004": {
    "_name": "",
    "_matcher": "启动主要(每回合1次)，本角色力量≥7000时从手牌登场1张力量≤5000、排除自身的革命军角色。",
    "_src": "wf-dsl",
    "activated": {
      "oncePerTurn": true,
      "if": {
        "selfPowerGte": 7000
      },
      "then": [
        {
          "op": "PlayCharFromHand",
          "filter": {
            "keyword": "革命军",
            "originalPowerLte": 5000,
            "excludeName": "安普里奥·伊万科夫"
          },
          "text": "从手牌登场1张力量≤5000的革命军角色"
        }
      ]
    }
  },

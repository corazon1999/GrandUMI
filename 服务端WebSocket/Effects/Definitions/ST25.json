{
  "ST25-001": {
    "_name": "爱比达",
    "_note": "【登场时】领袖为“巴奇”时抽3张丢弃2张（“≥2张费用≥5角色时此角色费用+1”持续部分由 C# 实现）。",
    "triggers": [
      {
        "on": "OnEnterField",
        "if": { "leaderNameEquals": "巴奇" },
        "then": [
          { "op": "Draw", "n": 3 },
          { "op": "DiscardOwnChosen", "n": 2 }
        ]
      }
    ]
  },
  "ST25-003": {
    "_name": "克洛克达尔&米霍克",
    "_note": "【登场时】抽2张丢弃1张，之后将手牌中最多1张费用≤4《十字公会》角色登场（“守护替身”部分由 C# 实现）。",
    "triggers": [
      {
        "on": "OnEnterField",
        "then": [
          { "op": "Draw", "n": 2 },
          { "op": "DiscardOwnChosen", "n": 1 },
          { "op": "PlayCharFromHand", "filter": { "keyword": "十字公会", "originalCostLte": 4 }, "text": "手牌中最多1张费用≤4《十字公会》角色登场" }
        ]
      }
    ]
  },
  "ST25-004": {
    "_name": "巴奇",
    "_note": "【启动主要】弃1手牌+自身入废弃：领袖为“巴奇”时，将手牌中最多1张费用≤6《十字公会》角色登场。",
    "activated": {
      "cost": { "handDiscard": 1, "selfToTrash": true },
      "if": { "leaderNameEquals": "巴奇" },
      "then": [
        { "op": "PlayCharFromHand", "filter": { "keyword": "十字公会", "originalCostLte": 6 }, "text": "手牌中最多1张费用≤6《十字公会》角色登场" }
      ]
    }
  },
  "ST25-005": {
    "_name": "毛奇",
    "_note": "【KO时】领袖为“巴奇”且手牌≤3 时抽1张（“条件阻挡者+费用”持续部分由 C# 实现）。",
    "triggers": [
      {
        "on": "OnKO",
        "if": { "leaderNameEquals": "巴奇", "selfHandCountLte": 3 },
        "then": [ { "op": "Draw", "n": 1 } ]
      }
    ]
  }
}

{
  "OP08-008": {
    "_name": "",
    "_matcher": "登场时对方1张角色力量-1000;启动主要(咚!!-1并生命顶1张入手为成本)本回合赋予自身速攻。",
    "_src": "wf-dsl",
    "triggers": [
      {
        "on": "OnEnterField",
        "then": [
          {
            "op": "Choose",
            "prompt": "OpponentCharacter",
            "max": 1,
            "min": 0,
            "as": "$tgt"
          },
          {
            "op": "AddPowerThisTurn",
            "target": "$tgt",
            "delta": -1000
          }
        ]
      }
    ],
    "activated": {
      "cost": {
        "donReturn": 1,
        "lifeToHand": true
      },
      "oncePerTurn": true,
      "then": [
        {
          "op": "GiveKeyword",
          "target": "self",
          "keyword": "速攻",
          "duration": "ThisTurn"
        }
      ]
    }
  },

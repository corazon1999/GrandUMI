{
  "PRB02-003": {
    "_name": "幸运·鲁",
    "_matcher": "登场时可丢手牌1张力量≥6000角色:抽2",
    "triggers": [
      {
        "on": "OnEnterField",
        "cost": {
          "handDiscard": {
            "n": 1,
            "kind": "Character",
            "originalPowerGte": 6000,
            "text": "丢弃手牌中1张力量≥6000的角色卡牌（可放弃）"
          }
        },
        "then": [
          {
            "op": "Draw",
            "n": 2
          }
        ]
      }
    ]
  },
  "PRB02-004": {
    "_name": "杰丽·邦妮",
    "_matcher": "对方攻击时每回合1次将我方最多1张咚转活跃",
    "triggers": [
      {
        "on": "OnOppAttackDeclare",
        "oncePerTurn": true,
        "then": [
          {
            "op": "ActiveOwnDon",
            "n": 1
          }
        ]
      }
    ]
  },
  "PRB02-007": {
    "_name": "甚平",
    "_matcher": "已按官方文本逐项精确实现并通过自动化校验。",
    "triggers": [
      {
        "on": "OnEnterField",
        "then": [
          {
            "op": "LookTopReveal",
            "count": 5,
            "max": 1,
            "restTo": "bottom",
            "match": {
              "keyword": "王下七武海",
              "excludeName": "甚平"
            }
          }
        ]
      },
      {
        "on": "OnAttackDeclare",
        "then": [
          {
            "op": "Choose",
            "prompt": "OpponentCharacterCostLe1",
            "max": 1,
            "as": "$t"
          },
          {
            "op": "ReturnToDeckBottom",
            "target": "$t",
            "from": "field"
          }
        ]
      }
    ]
  },
  "PRB02-008": {
    "_name": "马尔高",
    "_matcher": "KO时抽2",
    "triggers": [
      {
        "on": "OnKO",
        "then": [
          {
            "op": "Draw",
            "n": 2
          }
        ]
      }
    ]
  },
  "PRB02-010": {
    "_name": "夏洛特·布玲",
    "_matcher": "登场时咚-2:领袖大妈海盗团且对方咚≥6→抽2,之后登场手牌1张力量6000-8000大妈海盗团角色",
    "triggers": [
      {
        "on": "OnEnterField",
        "cost": {
          "donReturn": 2
        },
        "if": {
          "leaderHasKeyword": "大妈海盗团",
          "oppDonTotalGte": 6
        },
        "then": [
          {
            "op": "Draw",
            "n": 2
          },
          {
            "op": "PlayCharFromHand",
            "filter": {
              "keyword": "大妈海盗团",
              "originalPowerGte": 6000,
              "originalPowerLte": 8000
            }
          }
        ]
      }
    ]
  },
  "PRB02-011": {
    "_name": "堂吉诃德·多弗拉门戈",
    "_matcher": "登场时领袖多色→咚卡组追加1张休息咚",
    "triggers": [
      {
        "on": "OnEnterField",
        "if": {
          "leaderColorCountGte": 2
        },
        "then": [
          {
            "op": "RefreshDon",
            "n": 1,
            "state": "rest"
          }
        ]
      }
    ]
  },
  "PRB02-012": {
    "_name": "奈美",
    "_matcher": "登场时确认顶5公开1张草帽一伙(除奈美)入手余放底",
    "triggers": [
      {
        "on": "OnEnterField",
        "then": [
          {
            "op": "LookTopReveal",
            "count": 5,
            "max": 1,
            "restTo": "bottom",
            "match": {
              "keyword": "草帽一伙",
              "excludeName": "奈美"
            }
          }
        ]
      }
    ]
  },
  "PRB02-013": {
    "_name": "月光·莫利亚",
    "_matcher": "登场时领袖恐怖之船海盗团→废弃区1张费用≤4角色休息登场,之后赋予我方1领袖/角色1张休息咚",
    "triggers": [
      {
        "on": "OnEnterField",
        "if": {
          "leaderHasKeyword": "恐怖之船海盗团"
        },
        "then": [
          {
            "op": "PlayCharFromTrash",
            "filter": {
              "originalCostLte": 4
            },
            "rest": true
          },
          {
            "op": "Choose",
            "prompt": "OwnLeaderOrCharacter",
            "max": 1,
            "as": "$t"
          },
          {
            "op": "AttachDon",
            "target": "$t",
            "n": 1,
            "from": "rest"
          }
        ]
      }
    ]
  },
  "PRB02-016": {
    "_name": "阿玉",
    "_matcher": "已按官方文本逐项精确实现并通过自动化校验。",
    "activated": {
      "cost": {
        "restSelf": true,
        "lifeToHandChoice": true
      },
      "then": [
        {
          "op": "Choose",
          "prompt": "OwnLeaderOrCharacter",
          "max": 1,
          "as": "$t"
        },
        {
          "op": "AddPowerThisTurn",
          "target": "$t",
          "delta": 3000
        }
      ]
    },
    "trigger": [
      {
        "op": "Choose",
        "prompt": "OpponentCharacterCostLe4",
        "max": 1,
        "as": "$t"
      },
      {
        "op": "Rest",
        "target": "$t"
      }
    ]
  },
  "PRB02-018": {
    "_name": "波特夹斯·D·艾斯",
    "_matcher": "已按官方文本逐项精确实现并通过自动化校验。",
    "triggers": [
      {
        "on": "OnEnterField",
        "then": [
          {
            "op": "PlayCharFromHandOrTrash",
            "filter": {
              "anyOf": [
                {
                  "nameEquals": "萨波",
                  "originalCostGte": 2,
                  "originalCostLte": 2
                },
                {
                  "nameEquals": "波特夹斯·D·艾斯",
                  "originalCostGte": 2,
                  "originalCostLte": 2
                },
                {
                  "nameEquals": "蒙奇·D·路飞",
                  "originalCostGte": 2,
                  "originalCostLte": 2
                }
              ]
            }
          }
        ]
      }
    ]
  }
}

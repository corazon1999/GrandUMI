      {
        "on": "OnEnterField",
        "then": [
          {
            "op": "RestOpponentCards",
            "n": 1
          }
        ]
      }
    ],
    "activated": {
      "oncePerTurn": false,
      "if": { "leaderHasKeyword": "草帽一伙" },
      "cost": { "selfToTrash": true },
      "then": [
        {
          "op": "Choose",
          "prompt": "OwnCharacter",
          "max": 1,
          "min": 0,
          "as": "$tgt",
          "filter": { "originalCostLte": 8 }
        },
        {
          "op": "Activate",
          "target": "$tgt"
        }
      ]
    }
  },

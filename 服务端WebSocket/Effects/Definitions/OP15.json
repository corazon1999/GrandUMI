{
  "OP15-004": {
    "_name": "海猫",
    "triggers": [{
      "on": "OnEnterField",
      "if": { "leaderPowerNotMoreThan": 0 },
      "then": [
        { "op": "Choose", "prompt": "OpponentCharacter", "max": 1, "as": "$tgt", "text": "选择对方最多 1 张角色 力量 -3000" },
        { "op": "AddPowerThisTurn", "target": "$tgt", "delta": -3000 }
      ]
    }]
  },
  "OP15-005": {
    "_name": "卡巴奇",
    "triggers": [{
      "on": "OnAttackDeclare",
      "if": { "donAttachedGteOpponent": 1 },
      "then": [{ "op": "AddPowerThisTurn", "target": "self", "delta": 2000 }]
    }]
  },
  "OP15-015": {
    "_name": "日熊",
    "triggers": [{
      "on": "OnEnterField",
      "then": [
        { "op": "Choose", "prompt": "OpponentCharacter", "max": 1, "as": "$tgt", "text": "选择对方 1 张角色赋予休息咚" },
        { "op": "AttachDon", "target": "$tgt", "n": 1, "from": "rest" },
        { "op": "Choose", "prompt": "OpponentCharacterWithDon", "max": 1, "as": "$tgt2", "text": "对方最多 1 张被赋予咚的角色 力量 -1000" },
        { "op": "AddPowerThisTurn", "target": "$tgt2", "delta": -1000 }
      ]
    }]
  },

{
  "OP15-011": {
    "_name": "帕鲁",
    "_matcher": "实现【KO时】我方领袖含《东海》时 KO 对方1张原本力量≤6000的角色；对方回合中获得阻挡者且力量+2000的纯持续修正无法表达，已忽略该持续部分。",
    "_src": "wf-dsl",
    "triggers": [
      {
        "on": "OnKO",
        "if": {
          "leaderHasKeyword": "东海"
        },
        "then": [
          {
            "op": "Choose",
            "prompt": "OpponentCharacter",
            "max": 1,
            "min": 0,
            "as": "$tgt",
            "filter": {
              "originalPowerLte": 6000
            }
          },
          {
            "op": "KO",
            "target": "$tgt"
          }
        ]
      }
    ]
  },
  "OP15-018": {
    "_name": "毛奇",
    "_matcher": "【攻击时】KO 对方1张被赋予咚!!且力量≤3000的角色：用 OpponentCharacterWithDon 限定被贴咚目标，filter originalPowerLte:3000 近似力量上限。",
    "_src": "wf-dsl",

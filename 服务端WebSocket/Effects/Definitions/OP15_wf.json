  "OP15-060": {
    "_name": "艾尼路",
    "_matcher": "实现【启动主要】咚-1自身获得阻挡者并弃1张手牌；前半段持续(不会因对方效果离场、力量+2000)属静态修正未实现。",
    "_src": "wf-dsl",
    "activated": {
      "cost": {
        "donReturn": 1
      },
      "then": [
        {
          "op": "GiveKeyword",
          "target": "self",
          "keyword": "阻挡者",
          "duration": "UntilNextOpponentEndPhase"
        },
        {
          "op": "DiscardOwnChosen",
          "n": 1
        }
      ]
    }
  },
  "OP15-073": {
    "_name": "耶摩",
    "_matcher": "【登场时】从手牌登场≤1张费用1的\"神兵\"或费用1《神官》角色；【阻挡者】为纯关键词由系统处理。",
    "_src": "wf-dsl",
    "triggers": [
      {
        "on": "OnEnterField",
        "then": [
          {
            "op": "PlayCharFromHand",
            "filter": {
              "originalCostGte": 1,
              "originalCostLte": 1,
              "anyOf": [
                {
                  "nameEquals": "神兵"
                },
                {
                  "keyword": "神官"
                }
              ]
            },
            "text": "将手牌中最多1张费用为1的“神兵”或费用为1的《神官》角色登场"
          }
        ]
      }
    ]
  },

  "OP15-095": {
    "_name": "橡皮橡皮暴风雨",
    "_matcher": "主要(成本:将我方1张咚!!转为休息状态):废弃≥15时草帽一伙领袖或角色+3000;反击:废弃≥15时领袖或角色本战斗+4000(条件应在反击判定,惯例忽略)。",
    "_src": "wf-dsl",
    "main": {
      "cost": {
        "restActiveDon": 1
      },
      "if": {
        "ownTrashCountGte": 15
      },
      "then": [
        {
          "op": "Choose",
          "prompt": "OwnLeaderOrCharacter",
          "max": 1,
          "min": 0,
          "as": "$tgt",
          "filter": {
            "keyword": "草帽一伙"
          }
        },
        {
          "op": "AddPowerThisTurn",
          "target": "$tgt",
          "delta": 3000
        }
      ]
    },
    "counter": [
      {
        "op": "Choose",
        "prompt": "OwnLeaderOrCharacter",
        "max": 1,
        "min": 0,
        "as": "$tgt"
      },
      {
        "op": "AddPowerThisBattle",
        "target": "$tgt",
        "delta": 4000
      }
    ]
  },

  "OP15-044": {
    "_name": "克尔拉",
    "_matcher": "KO时确认卡组顶3张、公开≤1张德莱斯罗兹事件加手牌、其余放回卡组底(阻挡者为纯关键词)。",
    "_src": "wf-dsl",

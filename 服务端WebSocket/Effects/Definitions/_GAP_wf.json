{
  "OP09-001": {
    "_name": "杰克斯",
    "_matcher": "对方攻击时(OnOppAttackDeclare)选对方最多1张领袖或角色力量-1000。每回合1次为可选反应，triggers不支持oncePerTurn,核心效果可用DSL表达。",
    "_src": "wf-gap",
    "triggers": [
      {
        "on": "OnOppAttackDeclare",
        "then": [
          {
            "op": "Choose",
            "prompt": "OpponentLeaderOrCharacter",
            "max": 1,
            "min": 0,
            "as": "$tgt"
          },
          {
            "op": "AddPowerThisTurn",
            "target": "$tgt",
            "delta": -1000
          }
        ]
      }
    ]
  },
  "OP11-040": {
    "_name": "蒙奇·D·路飞",
    "_matcher": "我方回合开始时、咚≥8，确认顶5张公开≤1张草帽特征加手牌，其余按 LookTopReveal 标准回底(原卡牌支持自选顶/底重排，DSL 以回底近似)。",
    "_src": "wf-gap",
    "triggers": [
      {
        "on": "OnTurnStart",
        "if": {
          "isMyTurn": true,
          "selfDonTotalGte": 8
        },
        "then": [
          {
            "op": "LookTopReveal",
            "count": 5,
            "max": 1,
            "restTo": "bottom",
            "match": {
              "keyword": "草帽一伙"
            }
          }
        ]
      }
    ]
  },
  "P-008": {
    "_name": "大和",
    "_matcher": "【启动主要】横置自身:横置对方≤1张费用≤2角色,Choose+Rest表达。",
    "_src": "wf-gap",
    "activated": {
      "cost": {
        "restSelf": true
      },
      "then": [
        {
          "op": "Choose",
          "prompt": "OpponentCharacterCostLe2",
          "max": 1,
          "min": 0,
          "as": "$tgt"
        },
        {
          "op": "Rest",
          "target": "$tgt"
        }
      ]
    }
  },
  "P-009": {
    "_name": "特拉法尔加·罗",
    "_matcher": "【登场时】对方≥6手牌时对方1张生命入手,if oppHandCountGte+OppLifeToHand。",

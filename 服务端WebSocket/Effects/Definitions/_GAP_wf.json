  "P-047": {
    "_name": "蒙奇·D·路飞",
    "_matcher": "【咚!!×1】【攻击时】我方手牌≤3张时抽1张，用 OnAttackDeclare 触发+selfHandCountLte 条件表达。咚条件由引擎统一处理。",
    "_src": "wf-gap",
    "triggers": [
      {
        "on": "OnAttackDeclare",
        "if": {
          "selfHandCountLte": 3,
          "donAttachedGte": 1
        },
        "then": [
          {
            "op": "Draw",
            "n": 1
          }
        ]
      }
    ]
  },

{
  "ST17-002": {
    "_name": "特拉法尔加·罗",
    "_note": "【登场时】领袖含《王下七武海》时，将最多1张费用≤4 角色放回手牌（原文“可退我方1角色”作为成本，DSL 无该成本通道已略去；取对方角色近似）。",
    "triggers": [
      {
        "on": "OnEnterField",
        "if": { "leaderHasKeyword": "王下七武海" },
        "then": [
          { "op": "Choose", "prompt": "OpponentCharacter", "max": 1, "min": 0, "as": "$tgt", "filter": { "originalCostLte": 4 }, "text": "将最多1张费用≤4 角色放回手牌" },
          { "op": "BounceToHand", "target": "$tgt" }
        ]
      }
    ]
  },
  "ST17-005": {
    "_name": "马歇尔·D·提奇",
    "_note": "【启动主要】【每回合1次】弃1手牌（原文为“手牌放回卡组顶”，DSL 以弃牌近似支付）：赋予我方1张领袖或角色最多2张休息咚。",
    "activated": {
      "oncePerTurn": true,
      "cost": { "handDiscard": 1 },
      "then": [
        { "op": "Choose", "prompt": "OwnLeaderOrCharacter", "max": 1, "min": 0, "as": "$t", "text": "赋予我方1张领袖或角色最多2张休息咚" },
        { "op": "AttachDon", "target": "$t", "n": 2, "from": "rest" }
      ]
    }
  }
}

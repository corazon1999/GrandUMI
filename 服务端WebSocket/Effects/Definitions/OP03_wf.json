{
  "OP03-003": {
    "_name": "伊佐",
    "_matcher": "登场时确认卡组顶5张，公开1张含白胡子海盗团特征(排除自身伊佐)加入手牌，其余放回卡组底。",
    "_src": "wf-dsl",
    "triggers": [
      {
        "on": "OnEnterField",
        "then": [
          {
            "op": "LookTopReveal",
            "count": 5,
            "max": 1,
            "restTo": "bottom",
            "match": {
              "keyword": "白胡子海盗团",
              "excludeName": "伊佐"
            }
          }
        ]
      }
    ]
  },
  "OP03-009": {
    "_name": "哈尔塔",
    "_matcher": "启动主要每回合1次，给我方1张领袖或角色贴1张休息状态的咚。",
    "_src": "wf-dsl",
    "activated": {
      "oncePerTurn": true,
      "then": [
        {
          "op": "Choose",
          "prompt": "OwnLeaderOrCharacter",
          "max": 1,
          "min": 0,
          "as": "$t",
          "text": "选择我方1张领袖或角色赋予1张休息状态的咚"
        },
        {
          "op": "AttachDon",
          "target": "$t",
          "n": 1,
          "from": "rest"
        }
      ]
    }
  },
  "OP03-011": {
    "_name": "布拉门科",

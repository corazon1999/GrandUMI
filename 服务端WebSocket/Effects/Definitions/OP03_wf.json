  "OP03-017": {
    "_name": "十字火",
    "_matcher": "【主要】/【反击】领袖含白胡子海盗团时对方1张角色力量-4000；【触发】同主要效果（counter 无条件键限制按规范无法附 if，沿用同动作）。",
    "_src": "wf-dsl",
    "main": {
      "if": {
        "leaderHasKeyword": "白胡子海盗团"
      },
      "then": [
        {
          "op": "Choose",
          "prompt": "OpponentCharacter",
          "max": 1,
          "as": "$tgt"
        },
        {
          "op": "AddPowerThisTurn",
          "target": "$tgt",
          "delta": -4000
        }
      ]
    },
    "counter": [
      {
        "op": "Choose",
        "prompt": "OpponentCharacter",
        "max": 1,
        "as": "$tgt"
      },
      {
        "op": "AddPowerThisTurn",
        "target": "$tgt",
        "delta": -4000
      }
    ],
    "trigger": [
      {
        "op": "Choose",
        "prompt": "OpponentCharacter",
        "max": 1,
        "as": "$tgt"
      },
      {
        "op": "AddPowerThisTurn",
        "target": "$tgt",
        "delta": -4000
      }
    ]
  },

{
  "ST28-001": {
    "_name": "阿修罗童子",
    "_note": "【登场时】领袖含《和之国》且对方生命≥3 时，KO 对方最多1张原本费用≤5 角色。",
    "triggers": [
      {
        "on": "OnEnterField",
        "if": { "leaderHasKeyword": "和之国", "oppLifeCountGte": 3 },
        "then": [
          { "op": "Choose", "prompt": "OpponentCharacter", "max": 1, "min": 0, "as": "$tgt", "filter": { "originalCostLte": 5 }, "text": "KO 对方最多1张原本费用≤5 的角色" },
          { "op": "KO", "target": "$tgt" }
        ]
      }
    ]
  },
  "ST28-002": {
    "_name": "伊佐",
    "_note": "【登场时】领袖含《和之国》时本回合我方领袖获得【流放】（【咚×2】阻挡者持续部分由 C# 实现）。",
    "triggers": [
      {
        "on": "OnEnterField",
        "if": { "leaderHasKeyword": "和之国" },
        "then": [
          { "op": "GiveKeyword", "target": "selfLeader", "keyword": "流放" }
        ]
      }
    ]
  },
  "ST28-003": {
    "_name": "锦卫门",
    "_matcher": "【触发】我方领袖拥有《和之国》特征，且对方生命卡牌不多于3张的场合，此卡牌登场（触发其登场时）。",
    "_src": "wf-dsl",
    "trigger": {
      "if": { "leaderHasKeyword": "和之国", "oppLifeCountLte": 3 },
      "then": [
        { "op": "PlaySelf" }
      ]
    }
  },
  "ST28-004": {
    "_name": "光月桃之助",
    "_note": "【启动主要】【每回合1次】本回合此角色获得【速攻】并+1000（“生命≤2领袖+1000”持续部分由 C# 实现；原文成本“2张被赋予咚放回费用区”无对应通道已略去）。",
    "activated": {
      "oncePerTurn": true,
      "then": [
        { "op": "GiveKeyword", "target": "self", "keyword": "速攻" },
        { "op": "AddPowerThisTurn", "target": "self", "delta": 1000 }
      ]
    }
  },
  "ST28-005": {
    "_name": "大和",
    "_note": "【登场时】确认卡组顶5张，公开≤1张费用≥2《和之国》入手，余放回底（【咚×2】我方回合+3000 持续部分由 C# 实现）。",
    "triggers": [
      {
        "on": "OnEnterField",
        "then": [
          { "op": "LookTopReveal", "count": 5, "max": 1, "restTo": "bottom", "match": { "keyword": "和之国", "originalCostGte": 2 } }
        ]
      }
    ]
  }
}

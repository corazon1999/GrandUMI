# Docker Compose 会自动读取同目录下的 .env。
# 使用只允许目标仓库创建 Issue 的细粒度 Token，不要提交真实值。
GH_TOKEN=请填写GitHub细粒度Token

# 服务器时区，决定 SQLite 记录时间和日报日期。
TZ=Asia/Shanghai

# NapCat 容器写持久化目录时使用的宿主机用户与用户组。
NAPCAT_UID=1000
NAPCAT_GID=1000

# 仅在服务器私有 .env 中填写 s-蛇 QQ；官方入口据此尝试快速登录。
NAPCAT_ACCOUNT=

# 固定 QQ 登录设备使用的主机名；首次扫码后不得改动。
NAPCAT_HOSTNAME=grandumi-napcat

# 固定 NapCat 的 Linux 设备身份。更换此值会触发 QQ 重新登录。
NAPCAT_MAC_ADDRESS=d6:79:89:15:5e:e9

# s-鹰、s-鲨必须使用各自独立的 QQ、主机名、MAC 与命名卷，禁止复用 s-蛇登录目录。
# 在两个新账号完成扫码、OneBot 配置和 get_login_info 核验前，配置文件中保持 enabled=false。
NAPCAT_EAGLE_ACCOUNT=
NAPCAT_EAGLE_HOSTNAME=grandumi-napcat-eagle
NAPCAT_EAGLE_MAC_ADDRESS=d6:79:89:15:5e:ea

NAPCAT_SHARK_ACCOUNT=
NAPCAT_SHARK_HOSTNAME=grandumi-napcat-shark
NAPCAT_SHARK_MAC_ADDRESS=d6:79:89:15:5e:eb

# 薄包装先把停止信号转发给 QQ，再在该秒数后执行有界兜底清理。
NAPCAT_STOP_TIMEOUT_SECONDS=20

# 密码回退摘要不放在 .env；仅写入同目录、权限 600 的
# napcat-quick-password-md5.secret，并确保该文件不进入版本库或部署包。
# 当前锁定的 v4.15.19 不读取该摘要；文件只作为后续受控升级的恢复材料保留。

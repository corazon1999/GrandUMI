location = /backend/ready {
    rewrite ^ /ready break;
    include /etc/nginx/snippets/grandumi-active-backend.conf;
    proxy_set_header Host localhost;
}

location = /backend/version {
    rewrite ^ /version break;
    include /etc/nginx/snippets/grandumi-active-backend.conf;
    proxy_set_header Host localhost;
}

location /ws {
    include /etc/nginx/snippets/grandumi-active-backend.conf;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host localhost;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 75s;
    proxy_send_timeout 15s;
    proxy_connect_timeout 3s;
    proxy_buffering off;
}

location ~ ^/(audio|cards|cards-thumb|cards-webp|data|sprites|sprites-thumb|status-icons|vfx)/ {
    include /etc/nginx/snippets/grandumi-active-assets.conf;
    try_files $uri =404;
    add_header Access-Control-Allow-Origin "*" always;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header Cross-Origin-Resource-Policy "cross-origin" always;
    add_header X-Content-Type-Options nosniff always;
}

location / {
    include /etc/nginx/snippets/grandumi-active-frontend.conf;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 3s;
    proxy_read_timeout 30s;
}

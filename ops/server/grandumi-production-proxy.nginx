location = /backend/ready {
    rewrite ^ /ready break;
    include /etc/nginx/snippets/grandumi-active-backend.conf;
    proxy_set_header Host localhost;
}

location = /backend/version {
    rewrite ^ /version break;
    include /etc/nginx/snippets/grandumi-active-backend.conf;
    proxy_set_header Host localhost;
}

# 仅 QQ 机器人固定出口与本机运维可进入；游戏服务还会校验本机代理标记和随机密钥。
location = /internal/qq-whitelist/sync {
    if ($host != "direct.grand-umi.com") { return 404; }
    allow 103.146.230.37;
    allow 127.0.0.1;
    allow ::1;
    deny all;
    client_max_body_size 256k;
    include /etc/nginx/snippets/grandumi-active-backend.conf;
    proxy_set_header Host localhost;
    proxy_set_header X-GrandUMI-Internal-Source "qq-bug-bot@103.146.230.37";
    proxy_connect_timeout 3s;
    proxy_read_timeout 30s;
}

location = /internal/qq-whitelist/sync/status {
    if ($host != "direct.grand-umi.com") { return 404; }
    allow 103.146.230.37;
    allow 127.0.0.1;
    allow ::1;
    deny all;
    include /etc/nginx/snippets/grandumi-active-backend.conf;
    proxy_set_header Host localhost;
    proxy_set_header X-GrandUMI-Internal-Source "qq-bug-bot@103.146.230.37";
    proxy_connect_timeout 3s;
    proxy_read_timeout 15s;
}

location = /internal/qq-whitelist/sync/failure {
    if ($host != "direct.grand-umi.com") { return 404; }
    allow 103.146.230.37;
    allow 127.0.0.1;
    allow ::1;
    deny all;
    client_max_body_size 256k;
    include /etc/nginx/snippets/grandumi-active-backend.conf;
    proxy_set_header Host localhost;
    proxy_set_header X-GrandUMI-Internal-Source "qq-bug-bot@103.146.230.37";
    proxy_connect_timeout 3s;
    proxy_read_timeout 15s;
}

location = /internal/qq-whitelist/sync/notification-ack {
    if ($host != "direct.grand-umi.com") { return 404; }
    allow 103.146.230.37;
    allow 127.0.0.1;
    allow ::1;
    deny all;
    include /etc/nginx/snippets/grandumi-active-backend.conf;
    proxy_set_header Host localhost;
    proxy_set_header X-GrandUMI-Internal-Source "qq-bug-bot@103.146.230.37";
    proxy_connect_timeout 3s;
    proxy_read_timeout 15s;
}

location /ws {
    include /etc/nginx/snippets/grandumi-active-backend.conf;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host localhost;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 75s;
    proxy_send_timeout 15s;
    proxy_connect_timeout 3s;
    proxy_buffering off;
}

location ~ ^/(audio|cards|cards-thumb|cards-webp|data|sprites|sprites-thumb|status-icons|vfx)/ {
    include /etc/nginx/snippets/grandumi-active-assets.conf;
    try_files $uri =404;
    add_header Access-Control-Allow-Origin "*" always;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header Cross-Origin-Resource-Policy "cross-origin" always;
    add_header X-Content-Type-Options nosniff always;
}

location / {
    include /etc/nginx/snippets/grandumi-active-frontend.conf;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 3s;
    proxy_read_timeout 30s;
}

[Unit]
Description=GrandUMI 新香港候选服后端
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=grandumi
Group=grandumi
WorkingDirectory=/opt/grandumi-candidate/服务端WebSocket/publish
ExecStart=/opt/dotnet/dotnet /opt/grandumi-candidate/服务端WebSocket/publish/GrandUMIServer.dll 18080
Restart=always
RestartSec=2
TimeoutStopSec=25
KillSignal=SIGINT
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=GRANDUMI_DATA_DIR=/data/grandumi-candidate
Environment=GRANDUMI_NODE_ID=hk-candidate-01
Environment=GRANDUMI_MAX_CONNECTIONS=300
Environment=GRANDUMI_MAX_ROOMS=100
Environment=GRANDUMI_PRIVATE_SNAPSHOT_LOG=0
Environment=GRANDUMI_PROTOCOL_LOG=0
Environment=GRANDUMI_LATENCY_SUMMARY_SECONDS=60
LimitNOFILE=262144
CPUQuota=150%
MemoryMax=1G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/data/grandumi-candidate /opt/grandumi-candidate/服务端WebSocket/publish

[Install]
WantedBy=multi-user.target

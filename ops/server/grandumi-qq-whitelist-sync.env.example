# 默认必须保持关闭。上线时复制到 /etc/grandumi/qq-whitelist-sync.env，
# 权限设为 root:root 0600，并在机器人主机配置同一份随机密钥。
GRANDUMI_QQ_WHITELIST_SYNC_ENABLED=0
GRANDUMI_QQ_WHITELIST_SYNC_GROUP_ID=297542853
GRANDUMI_QQ_WHITELIST_SYNC_GROUP_NAME=GrandUMI测试群
# v2 固定双群并集；旧私密文件缺少本字段且旧群为 297542853 时会安全前向推导同一集合。
GRANDUMI_QQ_WHITELIST_SYNC_GROUP_IDS=297542853,524996856
GRANDUMI_QQ_WHITELIST_SYNC_TIMEZONE=Asia/Singapore
GRANDUMI_QQ_WHITELIST_SYNC_PROXY_ID=qq-bug-bot@103.146.230.37
GRANDUMI_QQ_WHITELIST_SYNC_SECRET=REPLACE_ME
GRANDUMI_QQ_WHITELIST_SYNC_MIN_MEMBERS=100
GRANDUMI_QQ_WHITELIST_SYNC_MAX_SHRINK_PERCENT=25
GRANDUMI_QQ_WHITELIST_SYNC_MAX_DELAY_SECONDS=600

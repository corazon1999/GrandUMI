[Unit]
Description=GrandUMI 正式服后端槽位 %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=8

[Service]
Type=simple
User=grandumi
Group=grandumi
EnvironmentFile=-/etc/grandumi/qq-whitelist-sync.env
EnvironmentFile=/etc/grandumi/backend-%i.env
WorkingDirectory=/opt/grandumi/slots/%i/backend
ExecStart=/opt/dotnet/dotnet /opt/grandumi/slots/%i/backend/GrandUMIServer.dll ${GRANDUMI_BACKEND_PORT}
Restart=always
RestartSec=2
TimeoutStartSec=45
TimeoutStopSec=25
KillSignal=SIGINT
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=GRANDUMI_DATA_DIR=/data/grandumi
Environment=GRANDUMI_ACCOUNT_DB=/data/grandumi-shared/accounts.db
Environment=GRANDUMI_ACCOUNT_DB_ACTIVATION_MARKER=/data/grandumi-shared/active
Environment=GRANDUMI_ACCOUNT_DB_PREPARED_MARKER=/data/grandumi-shared/prepared
Environment=GRANDUMI_RECORD_DAILY_ACTIVE=1
Environment=GRANDUMI_REQUIRE_SINGLE_WRITER=1
Environment=GRANDUMI_NODE_ID=hk-production-%i
Environment=GRANDUMI_MAX_CONNECTIONS=3000
Environment=GRANDUMI_MAX_ROOMS=600
Environment=GRANDUMI_PRIVATE_SNAPSHOT_LOG=0
Environment=GRANDUMI_PROTOCOL_LOG=0
Environment=GRANDUMI_LATENCY_SUMMARY_SECONDS=60
Environment=GRANDUMI_ADMIN_DEPLOY_DIR=/var/lib/grandumi-admin-deploy
LimitNOFILE=262144
CPUQuota=650%
MemoryMax=5G
Slice=grandumi-production.slice
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/data/grandumi /data/grandumi-shared /var/lib/grandumi-admin-deploy/requests

[Install]
WantedBy=multi-user.target

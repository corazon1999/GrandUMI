assets.grand-umi.com {
	encode zstd gzip

	@next_static {
		method GET HEAD
		path /_next/static/*
	}
	handle @next_static {
		uri strip_prefix /_next/static
		root * /opt/grandumi/opcgpro-web/.next/static
		header {
			Access-Control-Allow-Origin "*"
			Cache-Control "public, max-age=31536000, immutable"
			Cross-Origin-Resource-Policy "cross-origin"
			X-Content-Type-Options "nosniff"
		}
		file_server
	}

	@public_assets {
		method GET HEAD
		path /audio/* /cards/* /cards-thumb/* /cards-webp/* /data/* /sprites/* /sprites-thumb/* /status-icons/* /vfx/* /card-back-images/* /file.svg /globe.svg /next.svg /vercel.svg /window.svg
	}
	handle @public_assets {
		root * /opt/grandumi/opcgpro-web/public
		header {
			Access-Control-Allow-Origin "*"
			Cache-Control "public, max-age=31536000, immutable"
			Cross-Origin-Resource-Policy "cross-origin"
			X-Content-Type-Options "nosniff"
		}
		file_server
	}

	respond 404
}

server {
    listen 80;
    listen [::]:80;
    server_name test.grand-umi.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location / {
        return 308 https://test.grand-umi.com$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name test.grand-umi.com;
    client_max_body_size 1m;

    ssl_certificate /etc/letsencrypt/live/test.grand-umi.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/test.grand-umi.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:GrandUmiTestTls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location = /backend/ready {
        proxy_pass http://127.0.0.1:8081/ready;
        proxy_set_header Host localhost;
    }

    location = /backend/version {
        proxy_pass http://127.0.0.1:8081/version;
        proxy_set_header Host localhost;
    }

    location = /internal/qq-whitelist/sync {
        allow 8.210.155.25;
        allow 127.0.0.1;
        allow ::1;
        deny all;
        client_max_body_size 256k;
        proxy_pass http://127.0.0.1:8081/internal/qq-whitelist/sync;
        proxy_set_header Host localhost;
        proxy_set_header X-GrandUMI-Internal-Source "qq-bug-bot@8.210.155.25";
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
    }

    location = /internal/qq-whitelist/sync/status {
        allow 8.210.155.25;
        allow 127.0.0.1;
        allow ::1;
        deny all;
        proxy_pass http://127.0.0.1:8081/internal/qq-whitelist/sync/status;
        proxy_set_header Host localhost;
        proxy_set_header X-GrandUMI-Internal-Source "qq-bug-bot@8.210.155.25";
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }

    location = /internal/qq-whitelist/sync/notification-ack {
        allow 8.210.155.25;
        allow 127.0.0.1;
        allow ::1;
        deny all;
        proxy_pass http://127.0.0.1:8081/internal/qq-whitelist/sync/notification-ack;
        proxy_set_header Host localhost;
        proxy_set_header X-GrandUMI-Internal-Source "qq-bug-bot@8.210.155.25";
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }

    location /ws {
        proxy_pass http://127.0.0.1:8081/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host localhost;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 75s;
        proxy_send_timeout 15s;
        proxy_connect_timeout 3s;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
    }
}

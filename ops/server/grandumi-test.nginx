server {
    listen 80;
    listen [::]:80;
    server_name test.grand-umi.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location / {
        return 308 https://test.grand-umi.com$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name test.grand-umi.com;
    client_max_body_size 1m;

    ssl_certificate /etc/letsencrypt/live/test.grand-umi.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/test.grand-umi.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:GrandUmiTestTls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location = /backend/ready {
        proxy_pass http://127.0.0.1:8081/ready;
        proxy_set_header Host localhost;
    }

    location = /backend/version {
        proxy_pass http://127.0.0.1:8081/version;
        proxy_set_header Host localhost;
    }

    location = /internal/qq-whitelist/sync {
        allow 186.241.65.7;
        allow 127.0.0.1;
        allow ::1;
        deny all;
        client_max_body_size 256k;
        proxy_pass http://127.0.0.1:8081/internal/qq-whitelist/sync;
        proxy_set_header Host localhost;
        proxy_set_header X-GrandUMI-Internal-Source "qq-bug-bot@103.146.230.37";
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
    }

    location = /internal/qq-whitelist/sync/status {
        allow 186.241.65.7;
        allow 127.0.0.1;
        allow ::1;
        deny all;
        proxy_pass http://127.0.0.1:8081/internal/qq-whitelist/sync/status;
        proxy_set_header Host localhost;
        proxy_set_header X-GrandUMI-Internal-Source "qq-bug-bot@103.146.230.37";
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }

    location = /internal/qq-whitelist/sync/failure {
        allow 186.241.65.7;
        allow 127.0.0.1;
        allow ::1;
        deny all;
        client_max_body_size 256k;
        proxy_pass http://127.0.0.1:8081/internal/qq-whitelist/sync/failure;
        proxy_set_header Host localhost;
        proxy_set_header X-GrandUMI-Internal-Source "qq-bug-bot@103.146.230.37";
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }

    location = /internal/qq-whitelist/sync/notification-ack {
        allow 186.241.65.7;
        allow 127.0.0.1;
        allow ::1;
        deny all;
        proxy_pass http://127.0.0.1:8081/internal/qq-whitelist/sync/notification-ack;
        proxy_set_header Host localhost;
        proxy_set_header X-GrandUMI-Internal-Source "qq-bug-bot@103.146.230.37";
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }

    location /ws {
        proxy_pass http://127.0.0.1:8081/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host localhost;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 75s;
        proxy_send_timeout 15s;
        proxy_connect_timeout 3s;
        proxy_buffering off;
    }

    # 原图库已经迁移为 WebP；旧 PNG/JPG 链接仍能读取同名原图，不再产生永久 404。
    location ~* ^/cards/(?<grandumi_card_original>.+)\.(?:png|jpe?g|webp)$ {
        root /opt/grandumi-test/opcgpro-web/public;
        try_files $uri /cards/$grandumi_card_original.webp /cards-webp/$grandumi_card_original.webp /cards-thumb/$grandumi_card_original.webp =404;
        error_page 404 = @grandumi_asset_missing;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location ~ ^/(audio|cards|cards-thumb|cards-webp|data|sprites|sprites-thumb|status-icons|vfx)/ {
        root /opt/grandumi-test/opcgpro-web/public;
        try_files $uri =404;
        error_page 404 = @grandumi_asset_missing;
        gzip on;
        gzip_types application/json;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
    }
    location @grandumi_asset_missing {
        add_header Cache-Control "private, no-store, no-cache, max-age=0, must-revalidate" always;
        add_header CDN-Cache-Control "no-store" always;
        add_header Cloudflare-CDN-Cache-Control "no-store" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header X-Content-Type-Options nosniff always;
        return 404;
    }

}

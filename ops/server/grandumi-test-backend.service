[Unit]
Description=GrandUMI 测试服后端（WebSocket 8081）
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/grandumi-test/服务端WebSocket/publish
ExecStart=/usr/bin/dotnet /opt/grandumi-test/服务端WebSocket/publish/GrandUMIServer.dll 8081
Restart=always
RestartSec=3
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=GRANDUMI_LEADER_STATS_READ_PATH=/opt/grandumi/服务端WebSocket/Data/leader-stats.db
Environment=GRANDUMI_NODE_ID=test-01
Environment=GRANDUMI_MAX_CONNECTIONS=300
Environment=GRANDUMI_MAX_ROOMS=100
Environment=GRANDUMI_PRIVATE_SNAPSHOT_LOG=0
Environment=GRANDUMI_PROTOCOL_LOG=0
CPUQuota=50%
MemoryMax=768M

[Install]
WantedBy=multi-user.target
